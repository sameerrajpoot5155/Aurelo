# Data source: mock | firebase | api
VITE_DATA_SOURCE=mock

# Auth mode: demo | firebase
VITE_AUTH_MODE=demo

# Optional Firebase (when VITE_AUTH_MODE=firebase)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=

# Optional API base URL (when VITE_DATA_SOURCE=api)
# VITE_API_BASE_URL=http://localhost:3001/api
